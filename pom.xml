<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proyecto agregador (solo para abrir todo junto en Spring Tools y compilar con un comando).
  Cada servicio es independiente: tiene su propio pom.xml, su Dockerfile y se despliega por separado.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.minimundo</groupId>
    <artifactId>minimundo-boutique</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>MiniMundo Boutique</name>
    <description>Sistema e-commerce con arquitectura de microservicios para una boutique infantil</description>

    <modules>
        <module>ms-usuarios</module>
        <module>ms-catalogo</module>
        <module>ms-pedidos</module>
        <module>ms-logistica</module>
        <module>ms-atencion</module>
        <module>api-gateway</module>
        <module>web-frontend</module>
    </modules>
</project>
